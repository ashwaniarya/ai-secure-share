# SQLite for local dev; set to your Postgres URL in production.
# Railway's Postgres plugin provides DATABASE_URL automatically (postgres://...),
# which the app rewrites to the psycopg3 driver.
DATABASE_URL=sqlite:///./dev.db

# Public base URL used to build shareable links. Set this to your deployed URL
# in production. NOTE: no trailing slash — the app appends "/s/<slug>".
# Production value: https://airesponseshare.com
PUBLIC_BASE_URL=http://localhost:8000

# Directory of the built frontend served by FastAPI. The Docker image places it
# at ./static; leave unset for API-only local runs.
# STATIC_DIR=static

# --- Rate limiting (slowapi) -------------------------------------------------
# Central per-client-IP limits on the API. Format: "<count>/<period>".
# Counters are in-memory by default (per process, reset on restart); point
# RATE_LIMIT_STORAGE_URI at Redis (redis://...) to share state across replicas.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=60/minute
# RATE_LIMIT_CREATE=20/minute
# RATE_LIMIT_UNLOCK=5/minute
# RATE_LIMIT_STORAGE_URI=memory://
